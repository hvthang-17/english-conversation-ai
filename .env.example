# Copy to root .env for Compose; set your own local passwords.
# Backend imports root .env when run from backend/; process environment overrides file values. Use unquoted KEY=value syntax.
MYSQL_DATABASE=english_conversation
MYSQL_USER=english_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/english_conversation
SPRING_DATASOURCE_USERNAME=english_app
SPRING_DATASOURCE_PASSWORD=
# Reserved for future Gemini integration; not consumed by the scaffold yet.
GEMINI_API_KEY=
# Select supported model IDs after checking official docs and testing.
GEMINI_CHAT_MODEL=
GEMINI_AUDIO_MODEL=
GEMINI_FEEDBACK_MODEL=
# Phase 0 only: current user decision is offline preparation. Never enable without new approval.
PHASE0_ALLOW_LIVE=false
# Phase 3 text conversation. Generate a stable secret (at least 32 characters).
GEMINI_CHAT_ENABLED=false
CHAT_FINGERPRINT_SECRET=
# Local rolling 60-second quotas and optional lifetime attempts per database.
CHAT_GLOBAL_RPM=10
CHAT_USER_RPM=6
CHAT_GLOBAL_CONCURRENT=2
CHAT_TOTAL_ATTEMPT_LIMIT=0
# Raw audio only. Keep this directory private and outside backups.
# VOICE_TEMP_DIRECTORY=.runtime/voice
# VOICE_RAW_TTL_SECONDS=3600
# VOICE_DRAFT_TTL_SECONDS=1800
# VOICE_CLEANUP_DELAY_MS=300000
# Frontend public configuration belongs in frontend/.env.local (see its .env.example).

# Session local HTTP; production profile forces Secure=true (HTTPS required).
SESSION_COOKIE_SECURE=false
# Explicit one-time admin provisioning; never commit real values.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
