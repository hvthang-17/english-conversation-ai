{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: verify",
      "type": "shell",
      "command": "./mvnw",
      "windows": { "command": ".\\mvnw.cmd" },
      "args": ["verify"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "backend: dev (bootstrap)",
      "type": "shell",
      "command": "./mvnw",
      "windows": { "command": ".\\mvnw.cmd" },
      "args": ["spring-boot:run", "-Dspring-boot.run.profiles=bootstrap"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
